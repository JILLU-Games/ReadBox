[Unit]
Description=ReadBox restricted local encrypted backup broker (BR-02)
Documentation=https://github.com/JILLU-Games/ReadBox
Wants=docker.service
After=docker.service
ConditionPathExists=/opt/readbox/deployment/operations/compose_recovery.py
ConditionPathExists=/var/lib/readbox-backup/identity.txt

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/readbox
EnvironmentFile=/etc/readbox-backup-agent.env
ExecStart=/usr/bin/python3 /opt/readbox/deployment/backup-agent/agent.py --root /opt/readbox --project readbox --db-user readbox --db-name readbox --state-dir /var/lib/readbox-backup --archive-dir /var/backups/readbox-managed --lock-path /run/lock/readbox-backup-global.lock --socket-dir $READBOX_BACKUP_SOCKET_DIR
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
# No public listener; Docker daemon access stays in this host-only unit.

[Install]
WantedBy=multi-user.target
