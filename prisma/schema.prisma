generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt    @id @default(autoincrement())
  passwordHash String    @map("password_hash") @db.VarChar(128)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)
  isSuperuser  Boolean   @default(false) @map("is_superuser")
  username     String    @db.VarChar(150)
  firstName    String    @default("") @map("first_name") @db.VarChar(150)
  lastName     String    @default("") @map("last_name") @db.VarChar(150)
  email        String    @default("") @db.VarChar(254)
  phone        String    @default("") @db.VarChar(40)
  isStaff      Boolean   @default(false) @map("is_staff")
  isActive     Boolean   @default(true) @map("is_active")
  verificationStatus String @default("verified") @map("verification_status") @db.VarChar(24)
  passwordResetRequired Boolean @default(true) @map("password_reset_required")
  dateJoined   DateTime  @default(now()) @map("date_joined") @db.Timestamptz(6)

  accessPolicy      UserAccessPolicy?
  memberships       MailboxMembership[] @relation("MembershipUser")
  assignmentsMade   MailboxMembership[] @relation("MembershipAssigner")
  deletedMailboxes  Mailbox[]           @relation("MailboxDeletedBy")
  deletedMessages   Message[]           @relation("MessageDeletedBy")
  auditEvents       AuditLog[]
  sessions          AppSession[]
  passwordResetToken PasswordResetToken?
  administratorProfile AdministratorProfile?

  @@index([username])
  @@index([verificationStatus])
  @@map("users")
}

model AdminAccount {
  id                    BigInt         @id @default(autoincrement())
  username              String         @unique @db.VarChar(150)
  passwordHash          String         @map("password_hash") @db.VarChar(128)
  firstName             String         @default("") @map("first_name") @db.VarChar(150)
  lastName              String         @default("") @map("last_name") @db.VarChar(150)
  email                 String         @default("") @db.VarChar(254)
  isSuperuser           Boolean        @default(true) @map("is_superuser")
  isActive              Boolean        @default(true) @map("is_active")
  passwordResetRequired Boolean        @default(false) @map("password_reset_required")
  lastLogin             DateTime?      @map("last_login") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions              AdminSession[]
  resetToken            AdminResetToken?

  @@index([username])
  @@map("admin_accounts")
}

model AdminSession {
  id         BigInt       @id @default(autoincrement())
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  adminId    BigInt       @map("admin_id")
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  ipAddress  String?      @map("ip_address") @db.Inet
  userAgent  String       @default("") @map("user_agent") @db.VarChar(500)

  admin      AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdministratorProfile {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @unique @map("user_id")
  isSuperuser Boolean  @default(false) @map("is_superuser")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("administrator_profiles")
}

model LoginAttempt {
  id                BigInt   @id @default(autoincrement())
  usernameNormalized String  @map("username_normalized") @db.VarChar(150)
  ipAddress         String?  @map("ip_address") @db.Inet
  succeeded         Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([usernameNormalized])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([usernameNormalized, ipAddress, createdAt])
  @@map("login_attempts")
}

model UserAccessPolicy {
  id                 BigInt   @id @default(autoincrement())
  userId             BigInt   @unique @map("user_id")
  canCreateMailboxes Boolean? @map("can_create_mailboxes")
  canDeleteMessages  Boolean  @default(false) @map("can_delete_messages")
  canDeleteMailboxes Boolean  @default(false) @map("can_delete_mailboxes")
  maxMailboxes       Int?     @map("max_mailboxes")
  allowedDomainUuids Json     @default("[]") @map("allowed_domain_uuids")
  autoDeleteEnabled  Boolean? @map("auto_delete_enabled")
  autoDeleteDays     Int?     @map("auto_delete_days")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_access_policies")
}

model UserControlSettings {
  id                          BigInt   @id @default(autoincrement())
  signupEnabled               Boolean  @default(true) @map("signup_enabled")
  firstNameRequirement        String   @default("optional") @map("first_name_requirement") @db.VarChar(16)
  lastNameRequirement         String   @default("optional") @map("last_name_requirement") @db.VarChar(16)
  emailRequirement            String   @default("required") @map("email_requirement") @db.VarChar(16)
  phoneRequirement            String   @default("optional") @map("phone_requirement") @db.VarChar(16)
  minPasswordLength           Int      @default(12) @map("min_password_length")
  requireStrongPassword       Boolean  @default(true) @map("require_strong_password")
  verificationMode            String   @default("instant") @map("verification_mode") @db.VarChar(24)
  inviteCode                  String   @default("") @map("invite_code") @db.VarChar(120)
  allowedDomainUuids          Json     @default("[]") @map("allowed_domain_uuids")
  defaultMaxMailboxes         Int      @default(3) @map("default_max_mailboxes")
  autoProvisionStarterMailbox Boolean  @default(false) @map("auto_provision_starter_mailbox")
  defaultCanCreateMailboxes   Boolean  @default(true) @map("default_can_create_mailboxes")
  defaultCanDeleteMessages    Boolean  @default(false) @map("default_can_delete_messages")
  defaultCanDeleteMailboxes   Boolean  @default(false) @map("default_can_delete_mailboxes")
  autoDeleteEnabled           Boolean  @default(false) @map("auto_delete_enabled")
  autoDeleteDays              Int      @default(30) @map("auto_delete_days")
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_control_settings")
}

model AppSession {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    BigInt    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String    @default("") @map("user_agent") @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("app_sessions")
}

model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AdminResetToken {
  id        BigInt   @id @default(autoincrement())
  adminId   BigInt   @unique @map("admin_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_reset_tokens")
}

model Domain {
  id                  BigInt   @id @default(autoincrement())
  uuid                String   @unique @default(uuid()) @db.Uuid
  name                String   @db.VarChar(253)
  status              String   @default("active") @db.VarChar(16)
  verificationStatus  String   @default("pending") @map("verification_status") @db.VarChar(16)
  lastCheckedAt       DateTime? @map("last_checked_at") @db.Timestamptz(6)
  verificationDetails Json     @default("{}") @map("verification_details")
  isDefault           Boolean  @default(false) @map("is_default")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  mailboxes Mailbox[]

  @@index([status])
  @@index([verificationStatus])
  @@index([isDefault])
  @@map("domains")
}

model Mailbox {
  id                 BigInt    @id @default(autoincrement())
  uuid               String    @unique @default(uuid()) @db.Uuid
  domainId           BigInt    @map("domain_id")
  localPart          String    @map("local_part") @db.VarChar(64)
  emailAddress       String    @map("email_address") @db.VarChar(320)
  status             String    @default("active") @db.VarChar(16)
  maildirRelativePath String   @map("maildir_relative_path") @db.VarChar(255)
  totalMessages      BigInt    @default(0) @map("total_messages")
  unreadMessages     BigInt    @default(0) @map("unread_messages")
  lastReceivedAt     DateTime? @map("last_received_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById        BigInt?   @map("deleted_by_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  domain      Domain              @relation(fields: [domainId], references: [id], onDelete: Restrict)
  deletedBy   User?               @relation("MailboxDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  memberships MailboxMembership[]
  messages    Message[]

  @@index([status, createdAt])
  @@index([deletedAt, status])
  @@index([domainId])
  @@index([deletedById])
  @@index([createdAt])
  @@map("mailboxes")
}

model MailboxMembership {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  mailboxId    BigInt   @map("mailbox_id")
  assignedById BigInt?  @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User     @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  mailbox    Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("MembershipAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, mailboxId])
  @@index([userId, mailboxId])
  @@index([mailboxId, userId])
    @@index([assignedById])
  @@map("mailbox_memberships")
}

model Message {
  id                  BigInt    @id @default(autoincrement())
  uuid                String    @unique @default(uuid()) @db.Uuid
  mailboxId           BigInt    @map("mailbox_id")
  sourceFileKey       String    @map("source_file_key") @db.VarChar(1024)
  sourceSha256        String    @map("source_sha256") @db.VarChar(64)
  messageIdHeader     String    @default("") @map("message_id_header") @db.VarChar(998)
  senderName          String    @default("") @map("sender_name") @db.VarChar(500)
  senderAddress       String    @default("") @map("sender_address") @db.VarChar(320)
  recipientAddresses Json      @default("[]") @map("recipient_addresses")
  ccAddresses        Json      @default("[]") @map("cc_addresses")
  subject             String    @default("") @db.VarChar(998)
  receivedAt          DateTime? @map("received_at") @db.Timestamptz(6)
  parsedAt            DateTime  @map("parsed_at") @db.Timestamptz(6)
  textBody            String    @default("") @map("text_body") @db.Text
  sanitizedHtmlBody   String    @default("") @map("sanitized_html_body") @db.Text
  sizeBytes           BigInt    @default(0) @map("size_bytes")
  isRead              Boolean   @default(false) @map("is_read")
  hasAttachments      Boolean   @default(false) @map("has_attachments")
  parseStatus         String    @default("ok") @map("parse_status") @db.VarChar(16)
  parseWarning        String    @default("") @map("parse_warning") @db.Text
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById         BigInt?   @map("deleted_by_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  mailbox   Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  deletedBy User?        @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([mailboxId, sourceFileKey])
  @@index([senderAddress])
  @@index([subject])
  @@index([mailboxId, receivedAt(sort: Desc)])
  @@index([mailboxId, isRead])
  @@index([mailboxId, hasAttachments])
  @@index([mailboxId, deletedAt, isRead])
  @@index([deletedAt, id])
  @@index([deletedById])
  @@index([isRead])
  @@index([parseStatus])
  @@map("messages")
}

model Attachment {
  id                  BigInt   @id @default(autoincrement())
  uuid                String   @unique @default(uuid()) @db.Uuid
  messageId           BigInt   @map("message_id")
  originalFilename    String   @default("") @map("original_filename") @db.VarChar(1000)
  safeFilename        String   @map("safe_filename") @db.VarChar(255)
  storedFilename      String   @unique @map("stored_filename") @db.VarChar(255)
  declaredMimeType    String   @default("") @map("declared_mime_type") @db.VarChar(255)
  detectedMimeType    String   @default("") @map("detected_mime_type") @db.VarChar(255)
  sizeBytes           BigInt   @map("size_bytes")
  sha256              String   @db.VarChar(64)
  storageRelativePath String   @unique @map("storage_relative_path") @db.VarChar(500)
  isInline            Boolean  @default(false) @map("is_inline")
  contentId           String   @default("") @map("content_id") @db.VarChar(998)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model AuditLog {
  id               BigInt   @id @default(autoincrement())
  uuid             String   @unique @default(uuid()) @db.Uuid
  actorId          BigInt?  @map("actor_id")
  action           String   @db.VarChar(80)
  targetType       String   @default("") @map("target_type") @db.VarChar(80)
  targetIdentifier String   @default("") @map("target_identifier") @db.VarChar(255)
  ipAddress        String?  @map("ip_address") @db.Inet
  userAgent        String   @default("") @map("user_agent") @db.VarChar(500)
  details          Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt(sort: Desc)])
    @@index([actorId])
  @@map("audit_logs")
}

model ServiceHeartbeat {
  id         BigInt   @id @default(autoincrement())
  serviceName String  @unique @map("service_name") @db.VarChar(80)
  status     String   @default("unknown") @db.VarChar(32)
  details    Json     @default("{}")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  @@map("service_heartbeats")
}

model SiteSettings {
  id               BigInt   @id @default(autoincrement())
  siteName         String   @default("ReadBox") @map("site_name") @db.VarChar(120)
  siteTagline      String   @default("Self-hosted mail server and shared team inbox.") @map("site_tagline") @db.VarChar(200)
  logoPath         String   @default("") @map("logo_path") @db.VarChar(100)
  faviconPath      String   @default("") @map("favicon_path") @db.VarChar(100)
  supportEmail     String   @default("") @map("support_email") @db.VarChar(254)
  contactPhone     String   @default("") @map("contact_phone") @db.VarChar(40)
  officeAddress    String   @default("") @map("office_address") @db.VarChar(255)
  footerDescription String  @default("") @map("footer_description") @db.Text
  copyrightText    String   @default("Authorized team use only.") @map("copyright_text") @db.VarChar(255)
  sourceCodeUrl    String   @default("https://github.com/vibtools/ReadBox") @map("source_code_url") @db.VarChar(200)
  privacyUrl       String   @default("/privacy/") @map("privacy_url") @db.VarChar(500)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

model SiteSeoSettings {
  pageKey     String   @id @map("page_key") @db.VarChar(32)
  title       String   @default("") @db.VarChar(120)
  description String   @default("") @db.VarChar(320)
  imagePath   String   @default("") @map("image_path") @db.VarChar(255)
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_seo_settings")
}
