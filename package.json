{
  "name": "mailstack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run test:compat && npm run test:postfix && npm run test:setup && npm run test:auth && npm run test:audit && npm run test:admin && npm run test:messages && npm run test:auth:target-guard",
    "test:compat": "node --test tests/compatibility/original-source-contract.test.mjs tests/compatibility/service-worker.test.mjs tests/schema/postgres-schema.test.mjs",
    "test:postfix": "node --import tsx --test tests/postfix/read-adapter.test.ts",
    "test:audit": "node --conditions=react-server --import tsx --test tests/audit/record-and-policy.test.ts",
    "test:admin": "node --conditions=react-server --import tsx --test tests/admin/phase2-vcon.test.ts tests/admin/phase3-domains-mailboxes.test.ts tests/admin/phase4-ingestion-operations.test.ts",
    "test:messages": "node --conditions=react-server --import tsx --test tests/messages/phase5-users-workspace.test.ts",
    "test:setup": "node --experimental-test-module-mocks --conditions=react-server --import tsx --test tests/setup/authorization.test.ts tests/setup/lifecycle.test.ts tests/setup/progress.test.ts tests/setup/trusted-operations.test.ts",
    "test:ui": "vitest run --config vitest.config.mts",
    "test:auth:target-guard": "node --import tsx --test tests/auth/postgres-target.test.ts",
    "test:postgres": "node --conditions=react-server --import tsx scripts/testing/postgres-integration.ts",
    "mail:ingest": "node --conditions=react-server --import tsx scripts/mail/ingest.ts",
    "verify:safe": "node scripts/testing/verify-safe.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "auth:operator": "node --conditions=react-server --import tsx scripts/auth/operator.ts",
    "test:auth": "npm run test:auth:core && npm run test:auth:guards",
    "test:auth:core": "node --conditions=react-server --import tsx --test tests/auth/auth-flow.test.ts tests/auth/sign-in-result.test.ts tests/auth/route-access-policy.test.ts tests/auth/dual-mode-env.test.ts",
    "test:auth:guards": "node --experimental-test-module-mocks --conditions=react-server --import tsx --test tests/auth/route-guards.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/css-tree": "^3.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/sanitize-html": "^2.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postal-mime": "^4.2.1",
    "proper-lockfile": "^4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/turbopack": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
